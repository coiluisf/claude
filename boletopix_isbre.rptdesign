                <!-- NOME DO PAGADOR label -->
                <label id="pag_label1">
                    <property name="x">7pt</property>
                    <property name="y">323pt</property>
                    <property name="width">112pt</property>
                    <property name="height">7pt</property>
                    <property name="fontSize">5pt</property>
                    <property name="fontFamily">Arial</property>
                    <text>NOME DO PAGADOR/CPF/CNPJ/ENDEREÇO</text>
                </label>

                <!-- NOME DO PAGADOR value -->
                <text-data id="pag_nome1">
                    <property name="x">9pt</property>
                    <property name="y">331pt</property>
                    <property name="width">298pt</property>
                    <property name="height">9pt</property>
                    <property name="fontSize">6pt</property>
                    <property name="fontFamily">Arial</property>
                    <expression name="valueExpr">row["NOME"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- CPF/CNPJ value -->
                <text-data id="pag_cpf1">
                    <property name="x">9pt</property>
                    <property name="y">349pt</property>
                    <property name="width">298pt</property>
                    <property name="height">9pt</property>
                    <property name="fontSize">6pt</property>
                    <property name="fontFamily">Arial</property>
                    <expression name="valueExpr">"CPF/CNPJ: " + row["CPF"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- ENDEREÇO value -->
                <text-data id="pag_addr1">
                    <property name="x">9pt</property>
                    <property name="y">340pt</property>
                    <property name="width">298pt</property>
                    <property name="height">9pt</property>
                    <property name="fontSize">6pt</property>
                    <property name="fontFamily">Arial</property>
                    <expression name="valueExpr">row["ENDERECO"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- INFORMAÇÕES DE RESPONSABILIDADE label -->
                <label id="info_resp1">
                    <property name="x">7pt</property>
                    <property name="y">264pt</property>
                    <property name="width">154pt</property>
                    <property name="height">8pt</property>
                    <property name="fontSize">5pt</property>
                    <property name="fontFamily">Arial</property>
                    <text>INFORMAÇÕES DE RESPONSABILIDADE DO BENEFICIÁRIO</text>
                </label>

                <!-- DESCRIÇÃO -->
                <text-data id="descr1">
                    <property name="x">11pt</property>
                    <property name="y">272pt</property>
                    <property name="width">405pt</property>
                    <property name="height">51pt</property>
                    <property name="fontSize">6pt</property>
                    <property name="fontFamily">Arial</property>
                    <expression name="valueExpr">row["DESCRICAO"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- SACADOR/AVALISTA -->
                <label id="sacador1">
                    <property name="x">7pt</property>
                    <property name="y">682pt</property>
                    <property name="width">63pt</property>
                    <property name="height">8pt</property>
                    <property name="fontSize">5pt</property>
                    <property name="fontFamily">Arial</property>
                    <text>SACADOR/AVALISTA</text>
                </label>

                <!-- LINHA DIGITÁVEL (Recibo 1) -->
                <text-data id="linha_dig1">
                    <property name="x">193pt</property>
                    <property name="y">165pt</property>
                    <property name="width">275pt</property>
                    <property name="height">13pt</property>
                    <property name="fontSize">9pt</property>
                    <property name="fontFamily">Arial Black</property>
                    <property name="fontWeight">bold</property>
                    <property name="textAlign">right</property>
                    <expression name="valueExpr">row["LINHA_DIGITAVEL"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- Cód. Baixa -->
                <label id="cod_baixa1">
                    <property name="x">314pt</property>
                    <property name="y">353pt</property>
                    <property name="width">100pt</property>
                    <property name="height">8pt</property>
                    <property name="fontSize">5pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">right</property>
                    <text>Cód. Baixa</text>
                </label>

                <!-- Linha divisória intermediária (corte) -->
                <line id="line_cut">
                    <property name="x">2pt</property>
                    <property name="y">420pt</property>
                    <property name="width">573pt</property>
                    <property name="height">0pt</property>
                    <property name="borderStyle">dashed</property>
                    <property name="borderWidth">0.5pt</property>
                </line>

                <!-- ========== SEÇÃO 2: ARQUIVO DO BANCO ========== -->

                <!-- Logo BB (lado esquerdo) -->
                <image id="logobb2">
                    <property name="x">7pt</property>
                    <property name="y">478pt</property>
                    <property name="width">20pt</property>
                    <property name="height">20pt</property>
                    <property name="source">url</property>
                    <expression name="imageSource">"D:/ISBRE/Ico/bb.png"</expression>
                </image>

                <!-- "Banco do Brasil" (esquerda, seção 2) -->
                <label id="banco2">
                    <property name="x">32pt</property>
                    <property name="y">483pt</property>
                    <property name="width">111pt</property>
                    <property name="height">14pt</property>
                    <property name="fontSize">12pt</property>
                    <property name="fontWeight">bold</property>
                    <property name="fontFamily">Arial</property>
                    <text>Banco do Brasil</text>
                </label>

                <!-- "001-9" (código seção 2) -->
                <label id="codigo2">
                    <property name="x">149pt</property>
                    <property name="y">482pt</property>
                    <property name="width">33pt</property>
                    <property name="height">16pt</property>
                    <property name="fontSize">10pt</property>
                    <property name="fontWeight">bold</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">center</property>
                    <text>001-9</text>
                </label>

                <!-- LINHA DIGITÁVEL (Recibo 2 - maior) -->
                <text-data id="linha_dig2">
                    <property name="x">195pt</property>
                    <property name="y">484pt</property>
                    <property name="width">376pt</property>
                    <property name="height">15pt</property>
                    <property name="fontSize">10pt</property>
                    <property name="fontFamily">Arial Black</property>
                    <property name="fontWeight">bold</property>
                    <property name="textAlign">right</property>
                    <expression name="valueExpr">row["LINHA_DIGITAVEL"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- QR Code -->
                <image id="qrcode">
                    <property name="x">496pt</property>
                    <property name="y">691pt</property>
                    <property name="width">64pt</property>
                    <property name="height">64pt</property>
                    <property name="source">url</property>
                    <expression name="imageSource">"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=" + encodeURIComponent(row["PIX_TEXTOQRCODE"])</expression>
                </image>

                <!-- Pague esta cobrança com PIX -->
                <label id="pix_label">
                    <property name="x">5pt</property>
                    <property name="y">755pt</property>
                    <property name="width">150pt</property>
                    <property name="height">10pt</property>
                    <property name="fontSize">7pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="fontWeight">bold</property>
                    <text>Pague esta cobrança com PIX</text>
                </label>

                <!-- PIX TEXT (QR Code chave) -->
                <text-data id="pix_text">
                    <property name="x">5pt</property>
                    <property name="y">770pt</property>
                    <property name="width">574pt</property>
                    <property name="height">15pt</property>
                    <property name="fontSize">5pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">justified</property>
                    <expression name="valueExpr">row["PIX_TEXTOQRCODE"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- Data de Vencimento label (QR) -->
                <label id="data_venc_qr_label">
                    <property name="x">384pt</property>
                    <property name="y">692pt</property>
                    <property name="width">83pt</property>
                    <property name="height">10pt</property>
                    <property name="fontSize">7pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">center</property>
                    <text>Data de Vencimento:</text>
                </label>

                <!-- Data de Vencimento value (QR) -->
                <text-data id="data_venc_qr_val">
                    <property name="x">384pt</property>
                    <property name="y">705pt</property>
                    <property name="width">83pt</property>
                    <property name="height">12pt</property>
                    <property name="fontSize">8pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">center</property>
                    <expression name="valueExpr">row["DATA_VENCIMENTO"]</expression>
                    <property name="contentType">html</property>
                </text-data>

                <!-- Valor do Documento label (QR) -->
                <label id="valor_qr_label">
                    <property name="x">384pt</property>
                    <property name="y">729pt</property>
                    <property name="width">83pt</property>
                    <property name="height">10pt</property>
                    <property name="fontSize">7pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">center</property>
                    <text>Valor do Documento:</text>
                </label>

                <!-- Valor do Documento value (QR) -->
                <text-data id="valor_qr_val">
                    <property name="x">384pt</property>
                    <property name="y">741pt</property>
                    <property name="width">83pt</property>
                    <property name="height">12pt</property>
                    <property name="fontSize">8pt</property>
                    <property name="fontFamily">Arial</property>
                    <property name="textAlign">center</property>
                    <expression name="valueExpr">row["VALOR"]</expression>
                    <property name="contentType">html</property>
                    <format-number pattern="¤ #,##0.00;¤ -#,##0.00"/>
                </text-data>

                <!-- Autenticação mecânica -->
                <label id="autenticacao">
                    <property name="x">514pt</property>
                    <property name="y">364pt</property>
                    <property name="width">61pt</property>
                    <property name="height">8pt</property>
                    <property name="fontSize">5pt</property>
                    <property name="fontFamily">Arial</property>
                    <text>Autenticação mecânica</text>
                </label>

            </band>
        </section>
    </body>
</report>
